#
# MDEV-38721: flat (one-pass cross-layer) vector search modes
#
--source include/have_sequence.inc

--echo #
--echo # Test mhnsw_search_mode session variable
--echo #
select @@mhnsw_search_mode;
set mhnsw_search_mode = 'flat';
select @@mhnsw_search_mode;
set mhnsw_search_mode = 'flat_pruned';
select @@mhnsw_search_mode;
set mhnsw_search_mode = 'hierarchical';
select @@mhnsw_search_mode;
set mhnsw_search_mode = default;

--echo #
--echo # Small dataset: compare hierarchical / flat / flat_pruned results
--echo #
set rand_seed1=1, rand_seed2=2;
create table t1 (id int auto_increment primary key, v vector(5) not null, vector index (v));
insert t1 (v) values (x'e360d63ebe554f3fcdbc523f4522193f5236083d'),
                     (x'f511303f72224a3fdd05fe3eb22a133ffae86a3f'),
                     (x'f09baa3ea172763f123def3e0c7fe53e288bf33e'),
                     (x'b97a523f2a193e3eb4f62e3f2d23583e9dd60d3f'),
                     (x'f7c5df3e984b2b3e65e59d3d7376db3eac63773e'),
                     (x'de01453ffa486d3f10aa4d3fdd66813c71cb163f'),
                     (x'76edfc3e4b57243f10f8423fb158713f020bda3e'),
                     (x'56926c3fdf098d3e2c8c5e3d1ad4953daa9d0b3e'),
                     (x'7b713f3e5258323f80d1113d673b2b3f66e3583f'),
                     (x'6ca1d43e9df91b3fe580da3e1c247d3f147cf33e');

--echo # Hierarchical search (default)
set mhnsw_search_mode = 'hierarchical';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, x'B047263c9f87233fcfd27e3eae493e3f0329f43e') d from t1 order by d limit 5;

--echo # Flat search
set mhnsw_search_mode = 'flat';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, x'B047263c9f87233fcfd27e3eae493e3f0329f43e') d from t1 order by d limit 5;

--echo # Flat pruned search
set mhnsw_search_mode = 'flat_pruned';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, x'B047263c9f87233fcfd27e3eae493e3f0329f43e') d from t1 order by d limit 5;

drop table t1;

--echo #
--echo # Medium dataset: ~500 rows
--echo #
set rand_seed1=10, rand_seed2=20;
create table t2 (id int auto_increment primary key, v vector(10) not null, vector index (v));
insert into t2 (v) select vec_fromtext(json_arrayagg(rand() order by veclen.seq)) from seq_1_to_10 veclen, seq_1_to_500 numvecs group by numvecs.seq;

set mhnsw_search_mode = 'hierarchical';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t2 where id = 1)) d from t2 order by d limit 10;

set mhnsw_search_mode = 'flat';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t2 where id = 1)) d from t2 order by d limit 10;

set mhnsw_search_mode = 'flat_pruned';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t2 where id = 1)) d from t2 order by d limit 10;

drop table t2;

--echo #
--echo # Larger dataset with deeper layers
--echo #
set rand_seed1=100, rand_seed2=200;
create table t3 (id int auto_increment primary key, v vector(50) not null, vector index (v));
insert into t3 (v) select vec_fromtext(json_arrayagg(rand() order by veclen.seq)) from seq_1_to_50 veclen, seq_1_to_2000 numvecs group by numvecs.seq;

set mhnsw_search_mode = 'hierarchical';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t3 where id = 1)) d from t3 order by d limit 5;

set mhnsw_search_mode = 'flat';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t3 where id = 1)) d from t3 order by d limit 5;

set mhnsw_search_mode = 'flat_pruned';
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t3 where id = 1)) d from t3 order by d limit 5;

--echo #
--echo # Recall: every mode should return the true nearest neighbours.
--echo # Compare each mode's top-5 ids against the brute-force answer.
--echo #
--echo # brute force (no index)
--replace_regex /(\.\d{5})\d+/\1/
select id, vec_distance_euclidean(v, (select v from t3 where id = 1)) d from t3 ignore index (v) order by d limit 5;

--echo #
--echo # Distance-calculation counts on the 2000-row graph.
--echo # Mhnsw_search_distance_calc accumulates one tick per distance computation;
--echo # we read it before/after each query and diff. flat_pruned only ever skips
--echo # a node's lower layers, so it must never exceed naive flat.
--echo #
set mhnsw_search_mode = 'hierarchical';
let $b= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
--disable_result_log
select id from t3 order by vec_distance_euclidean(v, (select v from t3 where id = 1)) limit 5;
--enable_result_log
let $a= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
let $hier= `select $a - $b`;

set mhnsw_search_mode = 'flat';
let $b= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
--disable_result_log
select id from t3 order by vec_distance_euclidean(v, (select v from t3 where id = 1)) limit 5;
--enable_result_log
let $a= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
let $flat= `select $a - $b`;

set mhnsw_search_mode = 'flat_pruned';
let $b= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
--disable_result_log
select id from t3 order by vec_distance_euclidean(v, (select v from t3 where id = 1)) limit 5;
--enable_result_log
let $a= query_get_value(SHOW SESSION STATUS LIKE 'Mhnsw_search_distance_calc', Value, 1);
let $pruned= `select $a - $b`;

# Exact counts are dataset- and SIMD-dependent (the bloom filter's false-positive
# rate varies by implementation), so we assert only the structural invariant:
# pruning never expands more than naive flat, it only ever skips a node's lower
# layers. The identical result rows above already show recall is unchanged.
--echo # flat_pruned distance calcs <= flat distance calcs (invariant):
let $le= `select $pruned <= $flat`;
echo flat_pruned <= flat: $le;

drop table t3;
set mhnsw_search_mode = default;
